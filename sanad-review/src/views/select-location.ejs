<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>اختر النشاط التجاري - Whispr</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container">
    <h1>اختر النشاط التجاري اللي تبي تربطه</h1>
    <% if (!locationsByAccount.length || locationsByAccount.every(a => !a.locations.length)) { %>
      <p class="error">ما لقينا أي نشاط تجاري مرتبط بحساب Google هذا. تأكد إنك مالك أو مدير للـ Google Business Profile.</p>
    <% } %>
    <% locationsByAccount.forEach(function(entry) { %>
      <% entry.locations.forEach(function(loc) { %>
        <form method="POST" action="/auth/select-location" class="location-card">
          <input type="hidden" name="locationName" value="<%= loc.name %>" />
          <input type="hidden" name="businessName" value="<%= loc.title %>" />
          <div>
            <strong><%= loc.title %></strong>
            <% if (loc.storefrontAddress) { %>
              <div class="muted"><%= [loc.storefrontAddress.addressLines, loc.storefrontAddress.locality].flat().filter(Boolean).join('، ') %></div>
            <% } %>
          </div>
          <button type="submit">ربط هذا النشاط</button>
        </form>
      <% }) %>
    <% }) %>
    <p><a href="/">رجوع للوحة التحكم</a></p>
  </div>
</body>
</html>
