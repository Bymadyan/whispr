<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>الاشتراك - SanadPay</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>SanadPay</h1>
    <form method="POST" action="/logout"><button class="link-btn" type="submit">تسجيل خروج</button></form>
  </header>

  <div class="container narrow">
    <div class="accounts">
      <h2>الاشتراك</h2>

      <% if (!stripeConfigured) { %>
        <p class="error">نظام الدفع غير مفعّل بعد من إدارة المنصة. تواصل معنا.</p>
      <% } else if (sub && sub.status === 'active') { %>
        <p class="badge published">اشتراكك فعّال ✅</p>
        <p class="muted">التجديد القادم: <%= sub.current_period_end ? new Date(sub.current_period_end * 1000).toLocaleDateString('ar') : '-' %></p>
        <form method="POST" action="/billing/portal">
          <button class="btn secondary" type="submit">إدارة الاشتراك / الإلغاء</button>
        </form>
        <p><a href="/dashboard">الذهاب للوحة التحكم</a></p>
      <% } else { %>
        <% if (sub && sub.status && sub.status !== 'incomplete') { %>
          <p class="error">حالة اشتراكك الحالية: <%= sub.status %>. لازم تفعّل الاشتراك عشان تقدر تستخدم اللوحة.</p>
        <% } %>
        <p>اشترك الآن بـ <strong>35$ شهرياً</strong> وابدأ تستقبل مسودات ردود على تقييمات Google خلال دقائق.</p>
        <form method="POST" action="/billing/checkout">
          <button class="btn hero-cta" type="submit">الدفع عبر Stripe</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>
