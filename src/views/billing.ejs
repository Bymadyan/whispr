<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <title>Subscription - SanadPay</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>SanadPay</h1>
    <form method="POST" action="/logout"><button class="link-btn" type="submit">Log out</button></form>
  </header>

  <div class="container narrow">
    <div class="accounts">
      <h2>Subscription</h2>

      <% if (!stripeConfigured) { %>
        <p class="error">Payments aren't enabled yet. Please contact us.</p>
      <% } else if (sub && sub.status === 'active') { %>
        <p class="badge published">Your subscription is active ✅</p>
        <p class="muted">Next renewal: <%= sub.current_period_end ? new Date(sub.current_period_end * 1000).toLocaleDateString('en-US') : '-' %></p>
        <form method="POST" action="/billing/portal">
          <button class="btn secondary" type="submit">Manage / Cancel Subscription</button>
        </form>
        <p><a href="/dashboard">Go to dashboard</a></p>
      <% } else { %>
        <% if (sub && sub.status && sub.status !== 'incomplete') { %>
          <p class="error">Your subscription status: <%= sub.status %>. You need an active subscription to use the dashboard.</p>
        <% } %>
        <p>Subscribe now for <strong>$35/month</strong> and start getting draft replies to your Google reviews within minutes.</p>
        <form method="POST" action="/billing/checkout">
          <button class="btn btn-pay-black" type="submit">Pay</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>
