# انسخ هذا الملف باسم .env واملأ القيم (راجع README.md للتفاصيل)

# مفتاح عشوائي طويل لتشفير جلسات تسجيل الدخول
SESSION_SECRET=change-this-to-a-long-random-string

# منفذ التشغيل المحلي
PORT=3000

# رابط الموقع الأساسي (يُستخدم في روابط العودة من Stripe). محلياً اتركه كذا،
# وبعد النشر حطه رابط تطبيقك الحقيقي، مثلاً: https://sanad.up.railway.app
APP_BASE_URL=http://localhost:3000

# --- Stripe (نظام الاشتراك الشهري + رابط الدفع لكل فاتورة) ---
STRIPE_SECRET_KEY=
# أنشئ Product باسم "سند" وPrice شهري (مثلاً 15.00 USD)، وحط معرف الـ Price هنا (يبدأ بـ price_)
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# كود الدولة (ISO 3166-1 alpha-2) اللي تفتح فيه حسابات Stripe Connect للحرفيين (لازم دولة يدعمها Stripe)
STRIPE_CONNECT_COUNTRY=SA
# Signing secret لـ Webhook endpoint ثاني منفصل، Scoped على "Connected accounts" (راجع README) —
# يستقبل account.updated وpayout.paid/failed لإشعار الحرفي لما فلوسه فعلاً توصل حسابه البنكي
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Twilio WhatsApp (الربط مع بوت واتساب) ---
# من https://console.twilio.com : Account SID و Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# رقم واتساب المرسل، بصيغة "whatsapp:+14155238886" (رقم الـ Sandbox أثناء التجربة،
# أو رقمك المعتمد بعد موافقة Twilio على WhatsApp Business Profile)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Anthropic (Claude) لاستخراج بيانات الفاتورة من النص/الصوت المفرّغ ---
# بدونه، الأداة تستخدم استخراج بسيط جداً (يمسك أول رقم كمبلغ فقط) — التجربة تكون ضعيفة بدونه.
ANTHROPIC_API_KEY=

# --- OpenAI (Whisper) لتحويل الرسائل الصوتية إلى نص ---
# بدونه، الأداة ما تقدر تعالج الرسائل الصوتية وتطلب من المستخدم يكتب نصياً بدالها.
OPENAI_API_KEY=
