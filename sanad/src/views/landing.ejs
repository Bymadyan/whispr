<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SanadPay — Turn Your Voice Note into a Professional Invoice</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>SanadPay</h1>
    <nav class="nav-links">
      <a href="/login">Sign In</a>
      <a href="/signup" class="btn">Get Started</a>
    </nav>
  </header>

  <section class="hero">
    <h2>Document Your Work, Get Paid Faster</h2>
    <p class="hero-sub">
      Finished a job? Send a voice note on WhatsApp describing the work and amount — SanadPay instantly creates a professional invoice with a payment link. Get automatic payment reminders too.
    </p>
    <% if (whatsappNumber) { %>
      <a href="https://wa.me/<%= whatsappNumber %>?text=<%= encodeURIComponent('Hi') %>" class="btn hero-cta" target="_blank" rel="noopener">📱 Try Now on WhatsApp — Free</a>
      <p class="muted small">No signup, no password, no subscription. Unlimited use, completely free.</p>
    <% } else { %>
      <a href="/signup" class="btn hero-cta">Get Started</a>
    <% } %>
  </section>

  <section class="features">
    <div class="feature-card">
      <h3>🎙️ Voice Only</h3>
      <p>Describe your work and amount by voice on WhatsApp. SanadPay turns it into a polished invoice instantly.</p>
    </div>
    <div class="feature-card">
      <h3>💸 Never Forget to Collect</h3>
      <p>Automatic reminders if an invoice goes unpaid for more than 3 days.</p>
    </div>
    <div class="feature-card">
      <h3>📋 Simple Dashboard</h3>
      <p>All your invoices in one place — view, edit, and track payment status anytime.</p>
    </div>
    <div class="feature-card">
      <h3>📱 Works Within WhatsApp</h3>
      <p>No new app to download, no learning curve — everything happens in WhatsApp you already use.</p>
    </div>
  </section>

  <section class="pricing">
    <h2>Simple Pricing: Pay Only When You Get Paid</h2>
    <div class="price-card">
      <div class="price">5% <span class="muted">of each paid invoice</span></div>
      <ul>
        <li>Unlimited use, no monthly subscription ever</li>
        <li>Invoice + payment link for every job, no limits</li>
        <li>0% if invoice goes unpaid — no upfront fees</li>
        <li>No signup required, no payment card needed</li>
      </ul>
      <% if (whatsappNumber) { %>
        <a href="https://wa.me/<%= whatsappNumber %>?text=<%= encodeURIComponent('Hi') %>" class="btn hero-cta" target="_blank" rel="noopener">Start on WhatsApp</a>
      <% } else { %>
        <a href="/signup" class="btn hero-cta">Get Started</a>
      <% } %>
    </div>
  </section>

  <footer class="footer">
    <p class="muted small">
      SanadPay ·
      <a href="/terms" class="muted small">Terms & Conditions</a> ·
      <a href="/privacy" class="muted small">Privacy Policy</a>
    </p>
  </footer>
</body>
</html>
