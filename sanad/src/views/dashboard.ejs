<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>لوحة التحكم - سند</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>سند</h1>
    <nav class="nav-links">
      <a href="/connect-whatsapp">إعدادات واتساب</a>
      <form method="POST" action="/logout"><button class="link-btn" type="submit">تسجيل خروج</button></form>
    </nav>
  </header>

  <div class="container">
    <div class="accounts">
      <% if (!user.business_name) { %>
        <p>📝 خلي زبونك يشوف اسمك الحقيقي بالفاتورة بدل "مزوّد الخدمة":</p>
      <% } else { %>
        <p class="muted small">الاسم الظاهر بفواتيرك: <strong><%= user.business_name %></strong></p>
      <% } %>
      <form method="POST" action="/account/business-name" style="display:flex; gap:8px; flex-wrap:wrap;">
        <input type="text" name="businessName" placeholder="اسمك أو اسم نشاطك التجاري" value="<%= user.business_name || '' %>" required style="flex:1; min-width:200px; padding:10px; border-radius:8px; border:1px solid var(--border);" />
        <button class="btn" type="submit"><%= user.business_name ? 'تحديث' : 'حفظ' %></button>
      </form>
    </div>

    <% if (!link) { %>
      <div class="accounts">
        <p class="error">رقم واتسابك مو مربوط بعد.</p>
        <p><a href="/connect-whatsapp" class="btn">اربط رقمك الحين</a></p>
      </div>
    <% } %>

    <div class="stats-row">
      <div class="stat-card">
        <div class="value"><%= totals.unpaid.toFixed(2) %></div>
        <div class="label">إجمالي غير مسدد</div>
      </div>
      <div class="stat-card">
        <div class="value"><%= totals.paid.toFixed(2) %></div>
        <div class="label">إجمالي محصّل</div>
      </div>
      <div class="stat-card">
        <div class="value"><%= invoices.length %></div>
        <div class="label">عدد الفواتير</div>
      </div>
    </div>

    <div class="invoices">
      <h2>فواتيرك</h2>

      <% if (invoices.length === 0) { %>
        <div class="empty-state">
          <p>ما فيه فواتير بعد.</p>
          <p class="muted small">ابعت رسالة صوتية أو نصية على واتساب سند تصف فيها أي شغلة، وراح تظهر هنا فوراً.</p>
        </div>
      <% } %>

      <% invoices.forEach(inv => { %>
        <div class="invoice-card">
          <div class="invoice-info">
            <h4><%= inv.customer_name || 'زبون بدون اسم' %></h4>
            <p><%= inv.description || '-' %></p>
            <p><strong><%= inv.amount != null ? inv.amount : '؟' %> <%= inv.currency || '' %></strong></p>
            <p class="muted small"><%= new Date(inv.created_at * 1000).toLocaleString('ar') %> · <%= inv.source === 'voice' ? '🎙️ صوتي' : '⌨️ نصي' %></p>
            <% if (inv.payment_url) { %>
              <p class="small"><a href="/invoice/<%= inv.public_token %>" target="_blank" rel="noopener">🧾 فاتورة الزبون</a></p>
            <% } %>
          </div>
          <div>
            <span class="badge <%= inv.status === 'paid' ? 'paid' : '' %>"><%= inv.status === 'paid' ? 'مسددة' : 'غير مسددة' %></span>
            <% if (inv.status === 'paid') { %>
              <form method="POST" action="/invoices/<%= inv.id %>/mark-unpaid">
                <button class="btn secondary small-btn" type="submit">تراجع عن التسديد</button>
              </form>
            <% } else { %>
              <form method="POST" action="/invoices/<%= inv.id %>/mark-paid">
                <button class="btn small-btn" type="submit">علّمها مسددة</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
