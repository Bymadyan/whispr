<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign Up - SanadPay</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="login-box">
    <h1>SanadPay</h1>
    <p>Create your business account</p>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form method="POST" action="/signup">
      <input type="text" name="businessName" placeholder="Your name or business name" value="<%= values.businessName || '' %>" required />
      <input type="email" name="email" placeholder="Email address" value="<%= values.email || '' %>" required />
      <input type="password" name="password" placeholder="Password (minimum 8 characters)" minlength="8" required />
      <button type="submit">Create Account</button>
    </form>
    <p class="muted small">Already have an account? <a href="/login">Sign in</a></p>
  </div>
</body>
</html>
