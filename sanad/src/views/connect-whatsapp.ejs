<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Link WhatsApp - SanadPay</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>SanadPay</h1>
    <form method="POST" action="/logout"><button class="link-btn" type="submit">Sign Out</button></form>
  </header>

  <div class="container narrow">
    <% if (link) { %>
      <div class="accounts">
        <h2>WhatsApp Linked ✅</h2>
        <p class="muted">Linked number: <%= link.phone_number.replace('whatsapp:', '') %></p>
        <p>Now send a voice note or text to SanadPay on WhatsApp describing any job, and you'll get an invoice instantly.</p>
        <p><a href="/dashboard" class="btn">Go to Dashboard</a></p>
      </div>
    <% } else { %>
      <div class="accounts">
        <h2>Link Your WhatsApp</h2>
        <p>Two simple steps:</p>
        <ol>
          <li>Save this number to WhatsApp: <strong><%= whatsappNumber %></strong></li>
          <li>Send this code to the number:</li>
        </ol>

        <div class="code-box">
          <div class="code"><%= pendingCode.code %></div>
          <p class="muted small">Valid for 30 minutes</p>
        </div>

        <form method="POST" action="/connect-whatsapp/new-code">
          <button class="link-btn" type="submit">Code expired? Generate a new one</button>
        </form>

        <p class="muted small">After sending the code, refresh this page to confirm linking.</p>
        <p><a href="/connect-whatsapp">🔄 Refresh Page</a></p>
      </div>
    <% } %>
  </div>
</body>
</html>
