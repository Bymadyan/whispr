# انسخ هذا الملف باسم .env واملأ القيم (راجع README.md للتفاصيل)

# بيانات اعتماد OAuth من Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# لازم تكون نفس الرابط المسجل في Google Cloud Console بالضبط
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# مفتاح عشوائي طويل لتشفير جلسات تسجيل الدخول للوحة التحكم (أي نص عشوائي طويل)
SESSION_SECRET=change-this-to-a-long-random-string

# كلمة مرور بسيطة لحماية لوحة التحكم (MVP لعميل واحد، بدون نظام مستخدمين كامل)
DASHBOARD_PASSWORD=change-this-password

# منفذ التشغيل المحلي
PORT=3000

# اختياري: إذا حطيت مفتاح Anthropic API هنا، راح تولد الأداة ردود أذكى عبر Claude
# بدل القوالب الجاهزة. لو تركته فاضي، الأداة تشتغل بدون أي تكلفة إضافية بالقوالب الجاهزة.
ANTHROPIC_API_KEY=
